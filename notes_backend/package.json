{
    "name": "minimal-express-app",
    "version": "1.0.0",
    "description": "Minimal Express app with scalable structure",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "jest",
        "lint": "eslint ."
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "joi": "^17.12.3",
        "jsonwebtoken": "^9.0.4",
        "swagger-jsdoc": "^7.1.2",
        "swagger-ui-express": "^5.2.3",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "eslint": "^9.24.0",
        "globals": "^16.4.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.3"
    },
    "nodemonConfig": {
        "watch": ["src"],
        "ignore": [
            "node_modules",
            "package.json",
            "package-lock.json",
            "*.lock",
            "*.log",
            "*.md",
            ".git",
            "dist",
            "build"
        ],
        "ext": "js,json"
    }
}
